# ─────────────────────────────────────────────────────────────────────────────
# Rekomme — demo deployment (Hugging Face Space)
#
# Fill in the two keys under REQUIRED. Everything else is either pre-generated
# for you, set by the container, or deliberately left blank.
#
# On Hugging Face these become Space secrets:
#   Space → Settings → Variables and secrets → New secret
# Add OPENAI_API_KEY and TAVILY_API_KEY as *secrets*; the rest the image
# already sets, so you do not need to enter them there at all.
# ─────────────────────────────────────────────────────────────────────────────


# ── REQUIRED — fill these in ─────────────────────────────────────────────────

# platform.openai.com/api-keys — runs gpt-4o-mini for generation, all four
# graders and the query rewriter. Nothing works without it.
OPENAI_API_KEY=""

# app.tavily.com — with Pinecone switched off this is the ONLY retrieval
# source: web search, live Reddit search, news, YouTube and price history.
TAVILY_API_KEY=""


# ── PRE-GENERATED — already filled, no action needed ─────────────────────────

# Signs the login tokens. Generated fresh for this deployment.
# To roll your own: openssl rand -hex 32
JWT_SECRET_KEY="cfbff6774700330858d1b7c8f8eba8f90223539f6014ddb5768ea0c0b5006341"


# ── SET BY THE CONTAINER — listed for local runs only ────────────────────────
# The Dockerfile already exports all of these. Uncomment them only if you are
# running the app outside the container.

# BACKEND_URI="http://localhost:8000"
# POSTGRES_CONN_STRING="postgresql://postgres@localhost:5432/postgres"
# POSTGRES_HOSTNAME="localhost"
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="postgres"
# POSTGRES_PORT=5432
# POSTGRES_DB="postgres"

# The demo account seeded at startup. Change these if you want a different
# login for your reviewer.
# DEMO_USERNAME="reviewer"
# DEMO_PASSWORD="rekomme"


# ── LEAVE BLANK — the app degrades around these on purpose ───────────────────

# Pinecone. Blank flips DEMO_MODE on: vector retrieval is skipped and every
# query routes through query rewriting → Tavily web search → live Reddit
# search. All four graders still run.
PINECONE_API_KEY=""
PINECONE_ENVIRONMENT=""
PINECONE_INDEX_NAME="damg-final-proj"

# OxyLabs. Blank means merchant price listings are not fetched; the Tavily
# price history and buying advice still render.
OXYLABS_USERNAME=""
OXYLABS_PASSWORD=""

# AWS S3. Only used for resource caching in the batch pipeline, which does
# not run in this deployment.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
